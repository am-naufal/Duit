<?xml version="1.0" encoding="utf-8"?>
<!--
  Foreground ikon launcher — brand "Duitku" (docs/duitpribadi-splash). Sama
  dengan artwork dompet di ic_logo_duitku.xml, tanpa tile latar (itu jadi
  ic_launcher_background.xml). Diperkecil & dipusatkan ke dalam safe zone
  adaptive icon (lingkaran aman ⌀66 dp di kanvas 108 dp) supaya tidak
  terpotong mask apa pun (bulat/persegi bulat/tetesan). Dipakai juga sebagai
  `monochrome` di mipmap-anydpi/ic_launcher*.xml — untuk ikon bertema
  Android 13+, sistem hanya memakai cakupan alfa gambar ini (warna asli
  diabaikan, diganti tint sistem), jadi tidak perlu berkas terpisah.
-->
