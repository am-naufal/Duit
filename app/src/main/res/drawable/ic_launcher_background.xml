<?xml version="1.0" encoding="utf-8"?>
<!--
  Latar ikon launcher — brand "Duitku" (docs/duitpribadi-splash). Gradien
  sama seperti tile ic_logo_duitku.xml, tapi mengisi penuh kanvas 108×108
  tanpa sudut sendiri — bentuk luarnya (bulat/persegi bulat/tetesan)
  ditentukan launcher lewat masking adaptive icon.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <path android:pathData="M0,0 L108,0 L108,108 L0,108 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="0" android:startY="0"
                android:endX="108" android:endY="108"
                android:type="linear">
                <item android:offset="0.0" android:color="#FF1152E4" />
                <item android:offset="0.55" android:color="#FF8A3BD1" />
                <item android:offset="1.0" android:color="#FFF5297E" />
            </gradient>
        </aapt:attr>
    </path>
</vector>
